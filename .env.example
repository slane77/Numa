# The Hub — Day Webster intranet — environment variables
# Copy to .env.local for local dev, and set the same vars in your Vercel project.

# --- Supabase (public; safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# --- Supabase service role (server-only; bypasses RLS) ---
# Optional. Used by future admin tooling (e.g. promoting a user to editor/admin).
# Supabase dashboard → Settings → API → service_role key. NEVER expose publicly.
SUPABASE_SERVICE_ROLE_KEY=
