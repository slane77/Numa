# Numa environment variables
# Copy to .env.local for local dev, and set the same vars in your Vercel project.

# --- Supabase (public; safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# --- Anthropic (server-side ONLY — never expose to the browser) ---
# Used by app/api/meal-plan for AI meal planning (premium).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default models used by the meal-plan route.
# NUMA_MEAL_PLAN_MODEL=claude-opus-4-8
# NUMA_MEAL_PLAN_MODEL_FAST=claude-sonnet-4-6

# --- Supabase service role (server-only; bypasses RLS) ---
# Used by the Stripe webhook to set tier/billing fields. NEVER expose publicly.
# Supabase dashboard → Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (server-only) ---
# Secret key (sk_live_… / sk_test_…), the subscription Price ID, and the
# webhook signing secret (whsec_…) from the Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
